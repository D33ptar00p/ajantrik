{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.ssh)",
      "Read(~/.aws)",
      "Read(~/.config/gh)",
      "Read(~/.npmrc/**)",
      "Read(~/.netrc/**)",
      "Read(~/.git-credentials/**)",
      "Edit(.env)",
      "Edit(.env/**)",
      "Edit(.env.*)",
      "Edit(.factory/config)",
      "Edit(.factory/config/**)",
      "Edit(.claude)",
      "Edit(.claude/**)",
      "Edit(.github/workflows)",
      "Edit(.github/workflows/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.factory/security/guard.py\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.factory/security/guard.py\" bash"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.factory/security/guard.py\" files"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.factory/security/guard.py\" mcp"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.factory/security/guard.py\" untrusted"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "python3 .factory/factory.py *"
    ],
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ],
      "deniedDomains": [],
      "allowLocalBinding": false
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.npmrc",
        "~/.netrc",
        "~/.git-credentials"
      ],
      "allowRead": [],
      "allowWrite": [
        "/home/deep/Documents/Moveai/personal/ajantrik-factory",
        "/home/deep/Documents/Moveai/personal/ajantrik/.factory/jobs"
      ],
      "denyWrite": [
        ".env",
        ".env.*",
        ".factory/config/",
        ".claude/",
        ".github/workflows/"
      ]
    },
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "allowNestedUserNamespaces": false
  }
}
