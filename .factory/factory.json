{
  "version": 1,
  "repo": {
    "name": "ajantrik",
    "title": "ajantrik Software Factory",
    "default_base": "main",
    "worktree_root": "../{repo}-factory",
    "context_files": [
      "CLAUDE.md",
      "AGENTS.md"
    ]
  },
  "runtime": {
    "kind": "claude-cli",
    "models": {},
    "default_model": "sonnet",
    "per_agent": {},
    "concurrency": 4,
    "api": {
      "provider": "anthropic",
      "base_url": null,
      "api_key_ref": null,
      "temperature": null,
      "max_turns": 80,
      "tool_output_limit": 20000,
      "command_timeout_s": 600,
      "extra": {}
    },
    "claude_cli": {
      "binary": "claude",
      "permission_mode": "acceptEdits",
      "extra_args": []
    },
    "codex_cli": {
      "binary": "codex",
      "sandbox": "workspace-write",
      "extra_args": []
    }
  },
  "loop": {
    "max_rounds": 3,
    "start": null,
    "stages": [
      {
        "id": "spec",
        "kind": "agent",
        "title": "Spec",
        "next": null,
        "pos": null,
        "agent": "spec-writer",
        "output": "spec.md",
        "prompt": "",
        "read_builders": false,
        "on_fail": null,
        "note": "",
        "rerun_on_rework": "scope"
      },
      {
        "id": "design",
        "kind": "agent",
        "title": "Design",
        "next": null,
        "pos": null,
        "agent": "architect",
        "output": "design.md",
        "prompt": "",
        "read_builders": true,
        "on_fail": null,
        "note": "",
        "rerun_on_rework": "always"
      },
      {
        "id": "approval",
        "kind": "approval",
        "title": "Approve",
        "next": null,
        "pos": null,
        "agent": null,
        "output": null,
        "prompt": "",
        "read_builders": false,
        "on_fail": null,
        "note": "approve the spec and design",
        "rerun_on_rework": "never"
      },
      {
        "id": "tests",
        "kind": "agent",
        "title": "Tests",
        "next": null,
        "pos": null,
        "agent": "test-author",
        "output": "tests.md",
        "prompt": "",
        "read_builders": false,
        "on_fail": null,
        "note": "",
        "rerun_on_rework": "never"
      },
      {
        "id": "build",
        "kind": "builders",
        "title": "Build",
        "next": null,
        "pos": null,
        "agent": null,
        "output": null,
        "prompt": "",
        "read_builders": false,
        "on_fail": null,
        "note": "",
        "rerun_on_rework": "never"
      },
      {
        "id": "gate",
        "kind": "gate",
        "title": "Gate",
        "next": null,
        "pos": null,
        "agent": null,
        "output": null,
        "prompt": "",
        "read_builders": false,
        "on_fail": null,
        "note": "",
        "rerun_on_rework": "never"
      },
      {
        "id": "review",
        "kind": "reviewers",
        "title": "Review",
        "next": null,
        "pos": null,
        "agent": null,
        "output": null,
        "prompt": "",
        "read_builders": false,
        "on_fail": null,
        "note": "",
        "rerun_on_rework": "never"
      },
      {
        "id": "integrate",
        "kind": "integrate",
        "title": "Integrate",
        "next": null,
        "pos": null,
        "agent": "integrator",
        "output": "decision.md",
        "prompt": "",
        "read_builders": false,
        "on_fail": null,
        "note": "",
        "rerun_on_rework": "never"
      },
      {
        "id": "deliver",
        "kind": "delivery",
        "title": "Deliver",
        "next": null,
        "pos": null,
        "agent": null,
        "output": null,
        "prompt": "",
        "read_builders": false,
        "on_fail": null,
        "note": "",
        "rerun_on_rework": "never"
      }
    ]
  },
  "builders": [
    {
      "id": "main",
      "agent": "builder-main",
      "area_globs": [],
      "description": "the whole repository"
    }
  ],
  "reviewers": {
    "always": [
      {
        "id": "code",
        "agent": "reviewer-code",
        "chip": "code"
      },
      {
        "id": "security",
        "agent": "reviewer-security",
        "chip": "sec"
      }
    ],
    "routed": []
  },
  "gate": {
    "setup": [],
    "steps": [],
    "secrets": true,
    "clean_tree": true,
    "timeout_min": 20.0
  },
  "preflight": [],
  "worktree": [],
  "conventions": {
    "branch": "{type}/{key}_{words}",
    "branch_no_ticket": "{type}/{num}_{words}",
    "branch_types": {
      "Bug": "bugfix",
      "default": "feature"
    },
    "commit": "<type>: <what>",
    "pr_template": null
  },
  "connections": {
    "git": {
      "provider": "github",
      "remote": "origin",
      "host": null,
      "token_ref": null,
      "bitbucket_workspace": null,
      "bitbucket_repo": null
    },
    "tickets": {
      "provider": "none",
      "mode": "rest",
      "site": null,
      "project": null,
      "label": "factory",
      "jql": null,
      "email_ref": null,
      "token_ref": null,
      "epic_branch_glob": "*{epic}_*",
      "no_epic_branch": "block",
      "write_back": "none",
      "transition_to": null,
      "key_pattern": "[A-Z][A-Z0-9]+-\\d+"
    }
  },
  "delivery": {
    "mode": "none",
    "require_approval": true,
    "pr": {
      "draft": true,
      "reviewers": [],
      "labels": []
    },
    "direct": {
      "strategy": "ff-only",
      "push": true
    }
  },
  "security": {
    "refuse_paths": [
      ".claude/",
      ".factory/",
      ".github/workflows/"
    ],
    "refuse_patterns": [],
    "outgoing_files": [
      "pr.md",
      "pr-title.txt",
      "decision.md",
      "jira-comment.md"
    ],
    "npx_allow": [
      "tsc",
      "eslint",
      "vitest",
      "vite",
      "cypress",
      "prettier",
      "playwright",
      "tsx",
      "ts-node",
      "jest"
    ],
    "guard": {
      "env_reader_scripts": "gate.sh",
      "local_url_example": "http://localhost:8080/",
      "external_services": "Jira, Notion and Figma"
    }
  },
  "ui": {
    "port": 8000,
    "studio_port": 8765,
    "build_label": "",
    "job_files": [],
    "skip_dirs": [
      "mockup",
      "coverage",
      "e2e"
    ]
  },
  "_derived": {
    "jira_browse": "",
    "agents": {
      "architect": {
        "description": "Factory stage 2. Reads spec.md and designs the change (files, the contract between builders, tests, risks), writing <job folder>/design.md for human approval, including the Builders line that picks which builders run.",
        "model": "opus",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Write"
        ]
      },
      "builder-main": {
        "description": "Factory build stage. Implements its area of a job against the design and contract, makes test-author's tests pass, runs the repo's checks, commits, and writes build-<id>.md. May be resumed with each round's findings.",
        "model": "sonnet",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Edit",
          "Write"
        ]
      },
      "integrator": {
        "description": "Factory final stage. After a review round with all PASS, checks the job branch is ready to deliver, decides READY or ESCALATE, and drafts the PR title and body (and a ticket comment when asked). Never pushes, merges or writes to any service.",
        "model": "sonnet",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Write"
        ]
      },
      "reviewer-code": {
        "description": "Factory review lens (always runs). Reviews a job branch for correctness, the contract between builders, error handling and silent failures, repo conventions and test adequacy, and writes round-N/review-code.md.",
        "model": "sonnet",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Write"
        ]
      },
      "reviewer-security": {
        "description": "Factory review lens (always runs). Reviews a job branch for security issues (authorisation, secrets, injection, unsafe input handling, new network destinations, dependency and CI changes, injected behaviour) with a SOC 2 / ISO 27001 lens, and writes round-N/review-security.md.",
        "model": "opus",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Write"
        ]
      },
      "spec-writer": {
        "description": "Factory stage 1. Turns a ticket (or a one-line request) into <job folder>/spec.md with testable acceptance criteria grounded in the real code.",
        "model": "opus",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Write"
        ]
      },
      "test-author": {
        "description": "Factory stage 3. Writes failing tests for a job's acceptance criteria before any implementation, proves they fail for the right reason, commits them, and writes tests.md.",
        "model": "sonnet",
        "tools": [
          "Read",
          "Grep",
          "Glob",
          "Bash",
          "Edit",
          "Write"
        ]
      }
    },
    "order": [
      "spec",
      "design",
      "approval",
      "tests",
      "build",
      "gate",
      "review",
      "integrate",
      "deliver"
    ],
    "generated_by": "factory render"
  }
}
